{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Mini Wallet token labels v0",
 "type": "object",
 "required": [
  "schema",
  "date",
  "tokens"
 ],
 "properties": {
  "schema": {
   "const": "mw-labels/0"
  },
  "date": {
   "type": "string",
   "format": "date"
  },
  "generated_by": {
   "type": "string"
  },
  "tokens": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "label"
    ],
    "properties": {
     "rsi": {
      "type": "object",
      "properties": {
       "value": {
        "type": "number"
       },
       "period": {
        "type": "integer",
        "default": 14
       },
       "timeframe": {
        "type": "string",
        "default": "1d"
       },
       "state": {
        "enum": [
         "overbought",
         "warm",
         "neutral",
         "cool",
         "oversold"
        ]
       }
      }
     },
     "usd_sr": {
      "$ref": "#/$defs/sr"
     },
     "eth_sr": {
      "$ref": "#/$defs/sr"
     },
     "bullish_divergence": {
      "type": "object",
      "properties": {
       "present": {
        "type": "boolean"
       },
       "timeframe": {
        "type": "string"
       },
       "indicator": {
        "type": "string",
        "default": "RSI"
       }
      }
     },
     "label": {
      "type": "string",
      "description": "Short action text shown in the app"
     },
     "reasoning": {
      "type": "string",
      "maxLength": 400,
      "description": "Optional. 1-3 sentences explaining the label (shown when the chip is tapped). Older files without it stay valid."
     },
     "images": {
      "type": "array",
      "maxItems": 4,
      "description": "Optional. Chart images for the coin bottom sheet, same shape as setups. Normally two per token: [0] TOKEN/USD, [1] TOKEN/ETH (for ETH itself: ETH/USD and ETH/BTC). Shown only when the file is dated today.",
      "items": {
       "type": "object",
       "required": [
        "path"
       ],
       "properties": {
        "caption": {
         "type": "string",
         "maxLength": 120,
         "description": "e.g. 'USD · weekly' or 'vs ETH · daily'"
        },
        "path": {
         "type": "string",
         "pattern": "^50-projects/mini-wallet-research/labels/img/[^/]+\\.png(\\.b64)?$",
         "description": "base64 PNG (.png.b64) committed under labels/img/"
        }
       }
      }
     },
     "notes": {
      "type": "string"
     },
     "thresholds": {
      "type": "object",
      "description": "13.15: Mini Wallet labels purely by live price vs these levels. down (descending): price <= level -> label, deepest crossed wins. up (ascending): price >= level -> label, highest crossed wins. Otherwise base. 'label' must equal labelFor(ref_price).",
      "required": [
       "base",
       "down",
       "up"
      ],
      "properties": {
       "base": {
        "type": "string",
        "default": "Neutral"
       },
       "down": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "label",
          "price"
         ],
         "properties": {
          "label": {
           "type": "string"
          },
          "price": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       },
       "up": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "label",
          "price"
         ],
         "properties": {
          "label": {
           "type": "string"
          },
          "price": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       },
       "ref_price": {
        "type": "number"
       },
       "valid_from": {
        "type": "string"
       },
       "valid_until": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "valid_from": {
   "type": "string",
   "format": "date-time",
   "description": "13.15: when these thresholds took effect (CR offset). App: stale marker after 36h, labels keep using the thresholds."
  },
  "valid_until": {
   "type": "string",
   "format": "date-time",
   "description": "valid_from + 24h; the next daily run replaces the file."
  }
 },
 "$defs": {
  "sr": {
   "type": "object",
   "properties": {
    "monthly": {
     "$ref": "#/$defs/levels"
    },
    "weekly": {
     "$ref": "#/$defs/levels"
    },
    "daily": {
     "$ref": "#/$defs/levels"
    }
   }
  },
  "levels": {
   "type": "object",
   "properties": {
    "support": {
     "type": "array",
     "items": {
      "type": "number"
     }
    },
    "resistance": {
     "type": "array",
     "items": {
      "type": "number"
     }
    }
   }
  }
 }
}