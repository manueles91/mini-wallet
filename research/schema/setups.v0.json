{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw-setups/0",
  "title": "Mini Wallet proposed setups v0",
  "description": "setups/latest.json, read by Mini Wallet (Leverage page > Proposed setups). Proposals only; Manuel decides and executes. Low / very low confidence is invalid and ignored by the app.",
  "type": "object",
  "required": [
    "schema",
    "date",
    "setups"
  ],
  "properties": {
    "schema": {
      "const": "mw-setups/0"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "setups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "token",
          "direction",
          "instrument",
          "summary",
          "entry",
          "stop",
          "targets",
          "risk_reward",
          "confidence",
          "hypothesis",
          "created",
          "expires",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "long",
              "short"
            ]
          },
          "instrument": {
            "enum": [
              "perp",
              "option",
              "spot"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 100
          },
          "entry": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stop": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "risk_reward": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "reward per 1 risk; 3.2 shows as 1:3.2"
          },
          "confidence": {
            "enum": [
              "medium",
              "high",
              "very_high"
            ]
          },
          "hypothesis": {
            "type": "string",
            "description": "markdown"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "caption",
                "path"
              ],
              "properties": {
                "caption": {
                  "type": "string"
                },
                "path": {
                  "type": "string",
                  "pattern": "^50-projects/mini-wallet-research/setups/img/[^/]+\\.png(\\.b64)?$",
                  "description": "Bots MUST use .png.b64 (base64 text of the PNG; connectors can only push text). Plain .png still accepted."
                }
              }
            }
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "expires": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "proposed",
              "taken",
              "dismissed"
            ]
          }
        }
      }
    }
  }
}